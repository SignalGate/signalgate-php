{
    "name": "signalgate/signalgate-php",
    "description": "SignalGate backend SDK for PHP - a zero-dependency antifraud client with a synchronous check() gate and a fire-and-forget, fail-open log() buffer.",
    "type": "library",
    "license": "Apache-2.0",
    "homepage": "https://signalgate.ai",
    "keywords": ["signalgate", "antifraud", "fingerprint", "sdk"],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "autoload": {
        "psr-4": {
            "SignalGate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SignalGate\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
